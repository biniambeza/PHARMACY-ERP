# Copy to frontend/.env (or .env.local). Base URL of the backend API.
# "/api" is appended automatically if missing. Default: http://localhost:5000/api
VITE_API_URL=http://localhost:5000/api

# Optional: demo quick-fill buttons on the login page. Shown ONLY in `npm run dev`,
# never in production builds. Use test-database accounts only. Format: email:password
VITE_DEMO_PHARMACIST=
VITE_DEMO_ADMIN=

# Optional: Sentry error tracking for the browser app. Unset = disabled (the SDK is not
# even downloaded). No session replay; events are scrubbed (no cookies, headers,
# query strings, console output). Use a separate Sentry project from the backend.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
# 0..1, default 0 (no performance tracing)
VITE_SENTRY_TRACES_SAMPLE_RATE=0
