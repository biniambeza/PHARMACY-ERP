# Copy to backend/.env and fill in real values. Never commit .env.

# --- Required ---
# MongoDB connection string. Must be a replica set (MongoDB Atlas is fine):
# pharmacy creation, sales and PO receiving use transactions.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pharmacy-erp?retryWrites=true&w=majority
# Long random string used to sign JWTs, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional ---
PORT=5000
NODE_ENV=development
# JWT lifetime (zeit/ms format: 1h, 12h, 7d...). Default 12h.
JWT_EXPIRES_IN=12h
# Allowed browser origin(s) for CORS, comma-separated, exact match (no trailing slash).
# localhost:5173 and localhost:3000 are also allowed when NODE_ENV is not production.
CLIENT_URL=http://localhost:5173
# Optional, off by default: also allow Vercel preview URLs that start with this prefix,
# e.g. pharmacy-erp-git- allows https://pharmacy-erp-git-<branch>.vercel.app
CORS_ALLOW_VERCEL_PREVIEWS_PREFIX=
# Express "trust proxy" setting (needed for per-IP login rate limiting behind a proxy).
# Defaults to 1 hop when NODE_ENV=production, off otherwise.
TRUST_PROXY=

# --- Admin seeder (node utils/seedAdmin.js) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# --- Scheduled jobs (expiry checks, notifications, subscription checks) ---
# Unset = jobs run only when NODE_ENV=production
ENABLE_JOBS=
EXPIRY_JOB_CRON=0 1 * * *
JOBS_TZ=Africa/Addis_Ababa
# Monthly draft insurance claims (02:00 on the 1st); month edges follow JOBS_TZ
INSURANCE_CLAIM_CRON=0 2 1 * *

# --- Email (password reset links, daily summaries). Leave empty to only log ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SMS (optional generic HTTP provider). Leave empty to only log ---
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_FROM=

# --- Subscriptions (platform admin) ---
SUBSCRIPTION_GRACE_DAYS=3
SUBSCRIPTION_SUSPEND_AFTER_DAYS=7

# --- Fiscal e-invoicing (Ethiopia, Ministry of Revenues) ---
# Provider/mode are chosen per pharmacy in the E-Invoicing page; credentials are only read
# from here (never stored in the database). The 'mor' adapter is a stub until the official
# API specification and credentials are available: with these unset it refuses to submit.
# The 'mock' provider is TEST ONLY (fake MOCK- fiscal numbers, nothing sent to MoR).
EINVOICE_MOR_BASE_URL=
EINVOICE_MOR_API_KEY=

# --- Error tracking (optional, Sentry). Unset = disabled; never active when NODE_ENV=test ---
# Only unexpected / 5xx errors are sent; request bodies, cookies, auth headers and
# query strings are stripped. See docs/OPERATIONS.md.
SENTRY_DSN=
# Defaults: NODE_ENV / RENDER_GIT_COMMIT (or package.json version) / 0 (no tracing)
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# --- Health checks ---
# Timeout for the DB ping in GET /api/health/ready (ms). Default 2000.
HEALTH_READY_TIMEOUT_MS=2000
# GET /api/health reports RENDER_GIT_COMMIT (set automatically on Render) or GIT_COMMIT.
GIT_COMMIT=

# --- Automatic backups (optional; off unless BACKUP_CRON is set, independent of ENABLE_JOBS) ---
# e.g. 30 2 * * * = every day at 02:30 (JOBS_TZ applies). Render disks are ephemeral:
# copy backups off the server and keep MongoDB Atlas backups on too (docs/OPERATIONS.md).
BACKUP_CRON=
# Parent folder for backup-YYYYMMDD-HHmmss folders. Default backend/backups
BACKUP_DIR=
# Job backups older than this are deleted (the newest is always kept). 0 = keep all. Default 14
BACKUP_RETENTION_DAYS=14
# Set to false for plain JSON instead of gzip
BACKUP_GZIP=true
