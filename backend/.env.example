# Copy to backend/.env and fill in real values. Never commit .env.

# --- Required ---
# MongoDB connection string. Must be a replica set (MongoDB Atlas is fine):
# pharmacy creation, sales and PO receiving use transactions.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pharmacy-erp?retryWrites=true&w=majority
# Long random string used to sign JWTs, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string

# --- Optional ---
PORT=5000
NODE_ENV=development
# JWT lifetime (zeit/ms format: 1h, 12h, 7d...). Default 12h.
JWT_EXPIRES_IN=12h
# Allowed browser origin(s) for CORS, comma-separated, exact match (no trailing slash).
# localhost:5173 and localhost:3000 are also allowed when NODE_ENV is not production.
CLIENT_URL=http://localhost:5173
# Optional, off by default: also allow Vercel preview URLs that start with this prefix,
# e.g. pharmacy-erp-git- allows https://pharmacy-erp-git-<branch>.vercel.app
CORS_ALLOW_VERCEL_PREVIEWS_PREFIX=
# Express "trust proxy" setting (needed for per-IP login rate limiting behind a proxy).
# Defaults to 1 hop when NODE_ENV=production, off otherwise.
TRUST_PROXY=

# --- Admin seeder (node utils/seedAdmin.js) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
